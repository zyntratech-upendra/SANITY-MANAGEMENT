# ========================================================
# SWACHH-SMART BACKEND ENVIRONMENT CONFIGURATION (Render)
# ========================================================

PORT=5000
NODE_ENV=production

# MongoDB Atlas Database Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smart_sanitation?retryWrites=true&w=majority

# Vercel Frontend Domain URL for CORS
CLIENT_URL=https://your-frontend.vercel.app

# JWT Secret Key
JWT_SECRET=swachh_smart_jwt_secure_key_prod_2027

# Primary Admin Credentials (auto-initialized on first run)
ADMIN_EMAIL=admin@swachh.gov.in
ADMIN_PASSWORD=admin123

